name: Build Android APK

on:
  workflow_dispatch: # Memungkinkan build manual dari tab Actions
  push:
    tags:
      - 'v*' # Otomatis build saat Anda membuat tag versi (misal: v1.0.0)

jobs:
  build-apk:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Setup Java JDK
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Install Capacitor Dependencies
        run: |
          npm init -y
          npm install @capacitor/core @capacitor/cli @capacitor/android

      - name: Initialize Capacitor
        run: |
          # Inisialisasi Capacitor dengan direktori web di root (tempat index.html berada)
          npx cap init "SMK Pasundan Caringin" com.smkpasundan.caringin --web-dir=.
          npx cap add android

      - name: Sync Web Assets to Android
        run: npx cap sync android

      - name: Build Debug APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Upload APK to GitHub Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: SMK-Pasundan-Caringin-App-Debug
          path: android/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 30